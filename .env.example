# Copy to .env only if you want to override the local defaults.
# The app runs without this file.

APP_ENV=development
DATABASE_URL=sqlite:///./mini_jira.db
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ATTACHMENTS_DIR=./uploaded_attachments
# MAX_UPLOAD_BYTES=5242880

# Optional email delivery. Leave unset to keep notifications in-app only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
